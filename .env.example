# Mail-in-a-Box: Next Generation - Environment Variables
#
# Copia este archivo a .env y edita los valores.
#
# -----------------------------------------------------------------------------
# Dominio principal del servidor de correo.
# Este será el nombre de host del servidor y se usará para configurar
# todos los servicios, incluyendo SSL.
# -----------------------------------------------------------------------------
FQDN=mail.example.com

# -----------------------------------------------------------------------------
# Email para el registro de Let's Encrypt.
# Se usará para notificaciones sobre la renovación de certificados.
# -----------------------------------------------------------------------------
LETSENCRYPT_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Configuración de OpenLDAP
# -----------------------------------------------------------------------------
# Contraseña para el usuario administrador de LDAP (cn=admin,dc=example,dc=com)
LDAP_ADMIN_PASSWORD=admin

# El dominio base para LDAP. Normalmente se deriva del FQDN.
# Ejemplo: si FQDN=mail.example.com, LDAP_DOMAIN=example.com
LDAP_DOMAIN=example.com

# -----------------------------------------------------------------------------
# Configuración de la integración LDAP para docker-mailserver
# -----------------------------------------------------------------------------
# DN (Distinguished Name) del administrador de LDAP para las búsquedas.
LDAP_BIND_DN=cn=admin,dc=example,dc=com

# DN base para las búsquedas de usuarios y dominios.
LDAP_SEARCH_BASE=dc=example,dc=com
